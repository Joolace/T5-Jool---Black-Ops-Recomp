+// T5Jool: frame generation di Lossless Scaling (lsfg-vk). Su Android un'app non puo' attivare un livello Vulkan
+// esterno, ma liblsfg-vk.so sta dentro l'APK: la si carica qui e la si inserisce tra DXVK e il driver facendo
+// quello che farebbe il loader Vulkan (catena VK_LAYER_LINK_INFO in vkCreateInstance / vkCreateDevice).
+// Strutture del protocollo dei livelli (vk_layer.h), copiate perche' l'header non e' tra quelli di DXVK.
+namespace t5lsfg {
+  enum LayerFunction { LINK_INFO = 0, LOADER_DATA_CALLBACK = 1 };
+  struct InstanceLink {
+    InstanceLink* pNext;
+    PFN_vkGetInstanceProcAddr pfnNextGetInstanceProcAddr;
+    PFN_vkVoidFunction pfnNextGetPhysicalDeviceProcAddr;
+  };
+  struct InstanceCreateInfo {
+    VkStructureType sType; // VK_STRUCTURE_TYPE_LOADER_INSTANCE_CREATE_INFO
+    const void* pNext;
+    LayerFunction function;
+    union { InstanceLink* pLayerInfo; void* pad[2]; uint64_t pad64[2]; } u;
+  };
+  struct DeviceLink {
+    DeviceLink* pNext;
+    PFN_vkGetInstanceProcAddr pfnNextGetInstanceProcAddr;
+    PFN_vkGetDeviceProcAddr pfnNextGetDeviceProcAddr;
+  };
+  typedef VkResult (VKAPI_PTR *PFN_SetDeviceLoaderData)(VkDevice, void*);
+  struct DeviceCreateInfo {
+    VkStructureType sType; // VK_STRUCTURE_TYPE_LOADER_DEVICE_CREATE_INFO
+    const void* pNext;
+    LayerFunction function;
+    union { DeviceLink* pLayerInfo; PFN_SetDeviceLoaderData pfnSetDeviceLoaderData; void* pad[2]; } u;
+  };
+
+  PFN_vkGetInstanceProcAddr g_real;
+  PFN_vkGetInstanceProcAddr g_layer;
+  VkInstance g_instance;
+
+  // gli oggetti creati dal livello passano dal loader di Android, che imposta gia' la loro tabella
+  VKAPI_ATTR VkResult VKAPI_CALL setDeviceLoaderData(VkDevice, void*) { return VK_SUCCESS; }
+
+  VKAPI_ATTR VkResult VKAPI_CALL createInstance(const VkInstanceCreateInfo* ci, const VkAllocationCallbacks* alloc, VkInstance* out) {
+    InstanceLink link = { nullptr, g_real, nullptr };
+    InstanceCreateInfo info = { };
+    info.sType = VK_STRUCTURE_TYPE_LOADER_INSTANCE_CREATE_INFO;
+    info.pNext = ci->pNext;
+    info.function = LINK_INFO;
+    info.u.pLayerInfo = &link;
+    VkInstanceCreateInfo c = *ci;
+    c.pNext = &info;
+    auto fn = reinterpret_cast<PFN_vkCreateInstance>(g_layer(nullptr, "vkCreateInstance"));
+    VkResult r = fn ? fn(&c, alloc, out) : VK_ERROR_INITIALIZATION_FAILED;
+    if (r == VK_SUCCESS)
+      g_instance = *out;
+    return r;
+  }
+
+  VKAPI_ATTR VkResult VKAPI_CALL createDevice(VkPhysicalDevice pd, const VkDeviceCreateInfo* ci, const VkAllocationCallbacks* alloc, VkDevice* out) {
+    DeviceLink link = { nullptr, g_real, reinterpret_cast<PFN_vkGetDeviceProcAddr>(g_real(g_instance, "vkGetDeviceProcAddr")) };
+    DeviceCreateInfo info = { };
+    info.sType = VK_STRUCTURE_TYPE_LOADER_DEVICE_CREATE_INFO;
+    info.pNext = ci->pNext;
+    info.function = LINK_INFO;
+    info.u.pLayerInfo = &link;
+    DeviceCreateInfo cb = { };
+    cb.sType = VK_STRUCTURE_TYPE_LOADER_DEVICE_CREATE_INFO;
+    cb.pNext = &info;
+    cb.function = LOADER_DATA_CALLBACK;
+    cb.u.pfnSetDeviceLoaderData = setDeviceLoaderData;
+    VkDeviceCreateInfo c = *ci;
+    c.pNext = &cb;
+    auto fn = reinterpret_cast<PFN_vkCreateDevice>(g_layer(g_instance, "vkCreateDevice"));
+    return fn ? fn(pd, &c, alloc, out) : VK_ERROR_INITIALIZATION_FAILED;
+  }
+
+  VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL getInstanceProcAddr(VkInstance instance, const char* name) {
+    if (!std::strcmp(name, "vkGetInstanceProcAddr"))
+      return reinterpret_cast<PFN_vkVoidFunction>(&getInstanceProcAddr);
+    if (!std::strcmp(name, "vkCreateInstance"))
+      return reinterpret_cast<PFN_vkVoidFunction>(&createInstance);
+    if (!std::strcmp(name, "vkCreateDevice"))
+      return reinterpret_cast<PFN_vkVoidFunction>(&createDevice);
+    // prima dell'istanza il livello non ha ancora il "prossimo" a cui passare le chiamate globali
+    if (!instance)
+      return g_real(nullptr, name);
+    return g_layer(instance, name);
+  }
+
+  // con T5_LSFG=1 e liblsfg-vk.so presente, restituisce l'ingresso che passa dal livello; altrimenti quello vero
+  PFN_vkGetInstanceProcAddr wrap(PFN_vkGetInstanceProcAddr real) {
+    const char* on = getenv("T5_LSFG");
+    if (!real || !on || std::strcmp(on, "1"))
+      return real;
+    void* lib = dlopen("liblsfg-vk.so", RTLD_NOW | RTLD_LOCAL);
+    auto layer = lib ? reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(lib, "layer_vkGetInstanceProcAddr")) : nullptr;
+    if (!layer) {
+      dxvk::Logger::err(dxvk::str::format("LSFG: liblsfg-vk.so non caricata: ", lib ? "simbolo mancante" : dlerror()));
+      return real;
+    }
+    g_real = real;
+    g_layer = layer;
+    dxvk::Logger::info("LSFG: frame generation di Lossless Scaling attiva (liblsfg-vk.so)");
+    return &getInstanceProcAddr;
+  }
+}
+#endif
+
 namespace dxvk::vk {
 
