+    if (const char* gipa = getenv("DXVK_ANDROID_GIPA")) {
+      auto proc = reinterpret_cast<PFN_vkGetInstanceProcAddr>(strtoull(gipa, nullptr, 16));
+      if (proc) {
+        Logger::info(str::format("Vulkan: vkGetInstanceProcAddr dal driver personalizzato @ 0x", std::hex, reinterpret_cast<uintptr_t>(proc)));
+        return std::make_pair(HMODULE(nullptr), proc);
+      }
+    }
+#endif
