+  vec3 e = texel(f0 + ivec2(-1,  0)).rgb, f = texel(f0).rgb;
+  vec3 g = texel(f0 + ivec2( 1,  0)).rgb, h = texel(f0 + ivec2( 2,  0)).rgb;
+  vec3 i = texel(f0 + ivec2(-1,  1)).rgb, j = texel(f0 + ivec2( 0,  1)).rgb;
+  vec3 k = texel(f0 + ivec2( 1,  1)).rgb, l = texel(f0 + ivec2( 2,  1)).rgb;
+  vec3 n = texel(f0 + ivec2( 0,  2)).rgb, o = texel(f0 + ivec2( 1,  2)).rgb;
+  float bL = luma2(b), cL = luma2(c), eL = luma2(e), fL = luma2(f), gL = luma2(g), hL = luma2(h);
+  float iL = luma2(i), jL = luma2(j), kL = luma2(k), lL = luma2(l), nL = luma2(n), oL = luma2(o);
+
+  vec2 dir = vec2(0.0);
+  float len = 0.0;
+  easuSet(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
+  easuSet(dir, len, pp.x * (1.0 - pp.y),         cL, fL, gL, hL, kL);
+  easuSet(dir, len, (1.0 - pp.x) * pp.y,         fL, iL, jL, kL, nL);
+  easuSet(dir, len, pp.x * pp.y,                 gL, jL, kL, lL, oL);
+
+  vec2 dir2 = dir * dir;
+  float dirR = dir2.x + dir2.y;
+  bool zro = dirR < (1.0 / 32768.0);
+  dirR = zro ? 1.0 : inversesqrt(dirR);
+  dir.x = zro ? 1.0 : dir.x;
+  dir *= vec2(dirR);
+  len = len * 0.5;
+  len *= len;
+  float stretch = (dir.x * dir.x + dir.y * dir.y) / max(max(abs(dir.x), abs(dir.y)), 1e-8);
+  vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+  float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+  float clp = 1.0 / lob;
+
+  vec3 min4 = min(min(f, g), min(j, k));
+  vec3 max4 = max(max(f, g), max(j, k));
+  vec3 aC = vec3(0.0);
+  float aW = 0.0;
+  easuTap(aC, aW, vec2( 0.0, -1.0) - pp, dir, len2, lob, clp, b);
+  easuTap(aC, aW, vec2( 1.0, -1.0) - pp, dir, len2, lob, clp, c);
+  easuTap(aC, aW, vec2(-1.0,  1.0) - pp, dir, len2, lob, clp, i);
+  easuTap(aC, aW, vec2( 0.0,  1.0) - pp, dir, len2, lob, clp, j);
+  easuTap(aC, aW, vec2( 0.0,  0.0) - pp, dir, len2, lob, clp, f);
+  easuTap(aC, aW, vec2(-1.0,  0.0) - pp, dir, len2, lob, clp, e);
+  easuTap(aC, aW, vec2( 1.0,  1.0) - pp, dir, len2, lob, clp, k);
+  easuTap(aC, aW, vec2( 2.0,  1.0) - pp, dir, len2, lob, clp, l);
+  easuTap(aC, aW, vec2( 2.0,  0.0) - pp, dir, len2, lob, clp, h);
+  easuTap(aC, aW, vec2( 1.0,  0.0) - pp, dir, len2, lob, clp, g);
+  easuTap(aC, aW, vec2( 1.0,  2.0) - pp, dir, len2, lob, clp, o);
+  easuTap(aC, aW, vec2( 0.0,  2.0) - pp, dir, len2, lob, clp, n);
+  return min(max4, max(min4, aC / aW));
+}
+
+// ---------------------------------------------------------------------------------------------- FXAA
+// FXAA "lite" (Timothy Lottes, NVIDIA, dominio pubblico): cerca la direzione del bordo dalla luminanza dei 4 vicini
+// in diagonale e sfuma lungo il bordo. Lavora alla risoluzione del gioco, poi l'immagine si ingrandisce (bilineare).
+vec3 srcLinear(vec2 p) {
+  p = clamp(p, vec2(src_offset) + 0.5, vec2(src_offset + src_extent) - 0.5);
+  return textureLod(s_image, p, 0.0f).rgb;
+}
+
+float fxaaLuma(vec3 c) {
+  return dot(c, vec3(0.299, 0.587, 0.114));
+}
+
+vec3 fxaa(vec2 uv) {
+  vec2 p = vec2(src_offset) + vec2(src_extent) * uv;
+  vec3 rgbNW = srcLinear(p + vec2(-1.0, -1.0));
+  vec3 rgbNE = srcLinear(p + vec2( 1.0, -1.0));
+  vec3 rgbSW = srcLinear(p + vec2(-1.0,  1.0));
+  vec3 rgbSE = srcLinear(p + vec2( 1.0,  1.0));
+  vec3 rgbM  = srcLinear(p);
+  float lumaNW = fxaaLuma(rgbNW), lumaNE = fxaaLuma(rgbNE);
+  float lumaSW = fxaaLuma(rgbSW), lumaSE = fxaaLuma(rgbSE);
+  float lumaM  = fxaaLuma(rgbM);
+  float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));
+  float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));
+  // poco contrasto: niente bordo, si risparmiano le altre letture
+  if (lumaMax - lumaMin < max(0.0312, lumaMax * 0.125))
+    return rgbM;
+  vec2 dir = vec2(-((lumaNW + lumaNE) - (lumaSW + lumaSE)), (lumaNW + lumaSW) - (lumaNE + lumaSE));
+  float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE) * (0.25 * (1.0 / 8.0)), 1.0 / 128.0);
+  float rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);
+  dir = clamp(dir * rcpDirMin, vec2(-8.0), vec2(8.0));
+  vec3 rgbA = 0.5 * (srcLinear(p + dir * (1.0 / 3.0 - 0.5)) + srcLinear(p + dir * (2.0 / 3.0 - 0.5)));
+  vec3 rgbB = rgbA * 0.5 + 0.25 * (srcLinear(p + dir * -0.5) + srcLinear(p + dir * 0.5));
+  float lumaB = fxaaLuma(rgbB);
+  return (lumaB < lumaMin || lumaB > lumaMax) ? rgbA : rgbB;
+}
+
 void main() {
-  vec2 coord = vec2(src_offset) + vec2(src_extent) * i_coord;
-  o_color = input_to_sc_rgb(textureLod(s_image, coord, 0.0f));
+  vec4 color;
+  if (c_postaa == 1u) {
+    color = vec4(fxaa(i_coord), 1.0);
+  } else if (c_upscaler == 1u) {
+    color = vec4(sgsr1(i_coord), 1.0);
+  } else if (c_upscaler == 2u) {
+    color = vec4(fsr1(i_coord), 1.0);
+  } else {
+    vec2 coord = vec2(src_offset) + vec2(src_extent) * i_coord;
+    color = textureLod(s_image, coord, 0.0f);
+  }
+  o_color = input_to_sc_rgb(color);
   o_color = sc_rgb_to_output(o_color);
 }
