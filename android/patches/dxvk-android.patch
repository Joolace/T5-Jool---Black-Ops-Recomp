   static std::pair<HMODULE, PFN_vkGetInstanceProcAddr> loadVulkanLibrary() {
+    auto r = loadVulkanLibraryReal();
+#ifdef __ANDROID__
+    r.second = t5lsfg::wrap(r.second);
+#endif
+    return r;
+  }
+
+  static std::pair<HMODULE, PFN_vkGetInstanceProcAddr> loadVulkanLibraryReal() {
+#ifdef __ANDROID__
+    // T5Jool: driver Vulkan personalizzato (Turnip con libadrenotools). Il gioco carica il driver e passa
